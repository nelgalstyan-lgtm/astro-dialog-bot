# Скопируйте этот файл в .env и заполните своими значениями (для локального запуска).
# На хостинге (Render) эти же переменные задаются в панели Environment — не в файле.

# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Username канала, подписку на который проверяем (с собакой)
CHANNEL_USERNAME=@astrologicheskiy_dialog

# Прямая ссылка на канал (если отличается от t.me/<CHANNEL_USERNAME>)
CHANNEL_URL=https://t.me/astrologicheskiy_dialog

# Username самого бота без собаки, например astro_dialog_bot.
# Нужен для реферальных ссылок в разделе "Поделиться".
# Если не указать — бот определит его сам через getMe.
BOT_USERNAME=

# --- Только для продакшена (деплой на Render и т.п.) ------------------------

# polling — для локального запуска (по умолчанию).
# webhook — для хостинга (Render), см. README, раздел "Деплой".
RUN_MODE=polling

# Нужны только в режиме webhook. На Render заполняются автоматически
# (PORT и RENDER_EXTERNAL_URL), руками указывать не придется.
# PORT=10000
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=
